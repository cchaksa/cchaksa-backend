# Browser-visible values must use the VITE_ prefix. Do not put secrets here.
VITE_USE_MOCK_API=false

# Used only by the local Vite development server. The committed development
# default targets the dev API; override this in .env.development.local when
# running the Spring backend locally.
ADMIN_API_PROXY_TARGET=https://dev.admin.cchaksa.com
